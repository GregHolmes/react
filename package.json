{
  "name": "@deepgram/react-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "bun run --filter '@deepgram/react' build",
    "dev": "bun run --filter '@deepgram/react' dev",
    "typecheck": "bun run --filter '@deepgram/react' typecheck",
    "test": "bun run --filter '@deepgram/react' test",
    "lint": "bun run --filter '@deepgram/react' lint"
  },
  "overrides": {
    "brace-expansion": "5.0.5",
    "@deepgram/agent": "file:../agent/packages/sdk"
  }
}
